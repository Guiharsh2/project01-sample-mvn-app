pipeline{
    agent any

    stages{
        stage ('Clone the code'){
            steps{
                sh 'echo "Cloning the code"'
            }
        }
        stage ('Validate the code')
            steps {
                sh 'echo "Validating the code"'
            }
        stage ('Compile & Build the App')
            steps{
                sh 'echo "Building the code"'
            }
    
    }
}
